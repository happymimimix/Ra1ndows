<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <SignMode>Off</SignMode>
    <FrameWorkInteraction>DvOn</FrameWorkInteraction>
    <ForwardCompatibleCheck>false</ForwardCompatibleCheck>
    <ForwardProgressTest>None</ForwardProgressTest>
    <EnableKMDFLoaderMessages>false</EnableKMDFLoaderMessages>
    <EnableVerbose>false</EnableVerbose>
    <LoggingMemPages>1</LoggingMemPages>
    <UmdfVEnabled>false</UmdfVEnabled>
    <UmdfVTrackObjects>false</UmdfVTrackObjects>
    <UmdfVTrackRefCount>false</UmdfVTrackRefCount>
    <UmdfVLogLevel>2</UmdfVLogLevel>
    <UmdfVLogKd>true</UmdfVLogKd>
    <UmdfVHostFailKdBreak>true</UmdfVHostFailKdBreak>
    <UmdfVAttachToKd>true</UmdfVAttachToKd>
    <UmdfVerifyDownLevel>false</UmdfVerifyDownLevel>
  </PropertyGroup>
</Project>